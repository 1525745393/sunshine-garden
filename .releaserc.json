{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyConditionsCmd": "flutter pub get && flutter analyze --no-pub lib 2>&1 | tee /tmp/analyze.log; if grep -q 'error •' /tmp/analyze.log; then echo 'ERROR: Found compile errors in lib/'; exit 1; fi",
        "prepareCmd": "BUILD_NUM=$GITHUB_RUN_NUMBER && echo \"BUILD_NUM=$BUILD_NUM\" && sed -i \"s/^version: .*/version: ${nextRelease.version}+$BUILD_NUM/\" pubspec.yaml && echo '=== 版本文件已更新 ===' && grep '^version:' pubspec.yaml",
        "publishCmd": "bash scripts/build-android.sh"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["pubspec.yaml", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "build/app/outputs/flutter-apk/app-arm64-v8a-release.apk",
            "label": "APK (arm64-v8a) - ${nextRelease.version}"
          },
          {
            "path": "build/app/outputs/flutter-apk/app-armeabi-v7a-release.apk",
            "label": "APK (armeabi-v7a) - ${nextRelease.version}"
          },
          {
            "path": "build/app/outputs/flutter-apk/app-x86_64-release.apk",
            "label": "APK (x86_64) - ${nextRelease.version}"
          },
          {
            "path": "build/app/outputs/flutter-apk/app-release.apk",
            "label": "APK (universal) - ${nextRelease.version}"
          },
          {
            "path": "build/app/outputs/bundle/release/app-release.aab",
            "label": "AAB (Android App Bundle) - ${nextRelease.version}"
          }
        ]
      }
    ]
  ]
}
